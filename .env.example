# NGOField local development env.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ─── Vite-inlined (browser-visible) ──────────────────────────────────────────
# These get prefixed with VITE_ so Vite inlines them into the client bundle.
# They are PUBLIC — do not put secrets here.
VITE_BLOCKS_API_URL=https://blocksapi.slsblx.com
VITE_BLOCKS_X_BLOCKS_KEY=
VITE_BLOCKS_APP_DOMAIN=
VITE_BLOCKS_DEV_HOST=dttcgi.slsblx.com
VITE_BLOCKS_DEV_PORT=5173
VITE_BLOCKS_OIDC_CLIENT_ID=
VITE_BLOCKS_OIDC_URL=
VITE_BLOCKS_OIDC_SCOPE=openid profile offline_access

# ─── Server-only (NEVER prefixed with VITE_) ─────────────────────────────────
# These are read by `server/index.js` (and by the Vite middleware plugin in
# dev). They never reach the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
PORT=8080
